# Copy to `.envrc.local`, which is gitignored, and fill in. `.envrc` sources it.
#
# The explain stage reaches a provider in exactly two situations: recording cassettes
# (`uv run pytest -m "record and live"`) and a deliberate `EMENDRIX_EXPLAIN_CASSETTES=live`
# run. Everything else, CI included, replays committed cassettes and needs no key at all.

# Model access goes through OpenRouter. https://openrouter.ai/keys
export OPENROUTER_API_KEY="sk-or-v1-..."

# The pinned model is `openrouter:anthropic/claude-sonnet-5`; override to point the same code
# at a different one. Note that the cassette key is (model_id, sha256(prompt)), so changing this
# makes the committed cassettes miss until you re-record.
# export EMENDRIX_MODEL="openrouter:anthropic/claude-sonnet-5"

# The faithfulness judge is `openrouter:openai/gpt-5.6-sol`: a stronger model than the explainer
# and from a different vendor, which is the whole of the independence claim. Judgement cassettes
# are keyed on it the same way.
# export EMENDRIX_JUDGE_MODEL="openrouter:openai/gpt-5.6-sol"

# The Ed25519 private key, 64 hex characters, whose public half is the `v=MCPv1` TXT record that
# proves the MCP Registry namespace. Only `mcp-publisher login dns` reads it, run by hand when the
# MCP server's version moves; nothing in the pipeline or CI needs it. See docs/mcp-discovery.md.
# export EMENDRIX_MCP_KEY="..."
