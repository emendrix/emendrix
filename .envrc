# direnv entry point for a local checkout. Committed, and therefore it must never hold a
# secret: everything here is either a non-secret default or a redirection to a file that is
# gitignored.
#
#   cp .envrc.example .envrc.local   # then put your key in it
#   direnv allow
#
# Nothing in CI reads this file. The CI pipeline replays committed cassettes and never
# constructs a provider client, so it has no key to read; see .github/workflows/ci.yml.

# Cassette policy for local runs. `replay` is the safe default: a prompt nobody recorded
# fails loudly rather than quietly reaching for a provider and spending money.
export EMENDRIX_EXPLAIN_CASSETTES="${EMENDRIX_EXPLAIN_CASSETTES:-replay}"

# Credentials and any local overrides. Gitignored; absent by default.
source_env_if_exists .envrc.local
