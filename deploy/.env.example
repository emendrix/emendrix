# Copy to `deploy/.env` (gitignored) and set your own values. `docker compose` reads that file
# for the variables `compose.yaml` names; the values below are the hosted instance's, as a worked
# example.

# Required. The hostname readers reach this deployment at, without a scheme: the site's links
# and feed ids are built as `https://<it>/...`, and the MCP server answers only requests naming
# it. Changing it later moves every feed id, as the feeds page warns, so a reader's feed reader
# sees every entry again.
EMENDRIX_PUBLIC_HOST=emendrix.eu

# Optional. Where this deployment publishes its changelog data. Every page's footer links it;
# left empty, the footer names the data in words instead of linking a repository.
EMENDRIX_CHANGELOGS_URL=https://github.com/emendrix/changelogs

# Optional. A model key for the explain stage, which cannot run live without one; the
# deterministic half of the loop does not need it.
# OPENROUTER_API_KEY=
