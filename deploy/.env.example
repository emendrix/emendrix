# Copy to `deploy/.env` (gitignored) and set your own values. `docker compose` reads that file
# for the variables `compose.yaml` names; the values below are the hosted instance's, as a worked
# example.

# Required. The hostname readers reach this deployment at, without a scheme: the site's links
# and feed ids are built as `https://<it>/...`, and the MCP server answers only requests naming
# it. Changing it later moves every feed id, as the feeds page warns, so a reader's feed reader
# sees every entry again.
EMENDRIX_PUBLIC_HOST=emendrix.eu

# Optional. Where this deployment publishes its changelog data. Every page's footer links it;
# left empty, the footer names the data in words instead of linking a repository.
EMENDRIX_CHANGELOGS_URL=https://github.com/emendrix/changelogs

# Optional. A model key for the explain stage, which cannot run live without one; the
# deterministic half of the loop does not need it.
# OPENROUTER_API_KEY=

# --- The optional account service (`docs/accounts.md`) --------------------------------------
# Read only when compose runs with `--profile accounts`. Names only: set the values in `.env`,
# never here. compose sets the paths, the database address and the client-address header
# itself; `packages/emendrix-service/README.md` describes every setting.

# `--accounts` adds the "Watch this" links and the account shell to the site build; unset, the
# build passes `--no-accounts`. Set it only where the service runs.
EMENDRIX_ACCOUNTS_FLAG=

# Required by the profile. The database password, also written into the service's database
# address, so letters and digits only.
POSTGRES_PASSWORD=

# Required. The root of every signed token: base64 of at least 32 random bytes, for example
# `openssl rand -base64 32`. Changing it signs every reader out and voids every unsubscribe link.
EMENDRIX_SERVICE_SECRET_KEY=

# Optional. The hosts the service answers, comma-separated; unset, the public host and
# `localhost:8080`.
EMENDRIX_SERVICE_ALLOWED_HOSTS=

# Optional. `false` refuses new addresses while sign-in keeps working; unset means open.
EMENDRIX_SERVICE_SIGNUP_OPEN=
# Optional. Addresses that may sign up while sign-up is closed, comma-separated.
EMENDRIX_SERVICE_SIGNUP_ALLOWLIST=

# Required by `tick`. An ISO date: events the record detected before it are never emailed.
EMENDRIX_SERVICE_LIVE_SINCE=

# Required for sending. Any SMTP relay; the port defaults to 587 with STARTTLS.
EMENDRIX_SERVICE_SMTP_HOST=
EMENDRIX_SERVICE_SMTP_PORT=
EMENDRIX_SERVICE_SMTP_USERNAME=
EMENDRIX_SERVICE_SMTP_PASSWORD=
# Optional. `false` talks to the relay without STARTTLS, in the clear, so only to a relay on
# the same host or private network; unset means STARTTLS.
EMENDRIX_SERVICE_SMTP_STARTTLS=
# Required for sending. The `From` of every email, as `Name <address>`.
EMENDRIX_SERVICE_MAIL_FROM=

# Optional. Where `status --email` sends the daily status block.
EMENDRIX_SERVICE_OPERATOR_EMAIL=

# Optional. The path secret of the mail provider's event webhook; unset, the route answers 404.
EMENDRIX_SERVICE_WEBHOOK_SECRET=

# Optional. The zone and the local hour daily and weekly digests fall due in; unset,
# Europe/Brussels at 7.
EMENDRIX_SERVICE_TIMEZONE=
EMENDRIX_SERVICE_DIGEST_HOUR=

# Required by `backup ship`. Where copies go, as `user@host:directory` or
# `user@host:port:directory`, and the `age` public key they are encrypted to. The SSH key and the
# known-hosts file that pins the host's key are files in `deploy/account/`.
EMENDRIX_SERVICE_BACKUP_TARGET=
EMENDRIX_SERVICE_BACKUP_AGE_RECIPIENT=
